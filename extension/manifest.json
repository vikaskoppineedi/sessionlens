{
  "manifest_version": 3,
  "name": "SessionLens",
  "version": "0.1.0",
  "description": "Passive recorder for SessionLens: requests, cookies, storage and your actions. No debugger, no page changes.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["webRequest", "webNavigation", "cookies", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
